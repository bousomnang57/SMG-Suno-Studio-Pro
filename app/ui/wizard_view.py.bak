                            color: #1e293b;
                        }
                        QPushButton:hover {
                            border-color: #93c5fd;
                            background-color: #eff6ff;
                        }
                        QPushButton:checked {
                            border: 2px solid #2563eb;
                            background-color: #eff6ff;
                            font-weight: 700;
                            color: #1d4ed8;
                        }
                    """)

            if hasattr(self, "lbl_step1_mood_theme"):
                self.lbl_step1_mood_theme.setStyleSheet("color: #1e293b; font-weight: 600; font-size: 12px;")
            if hasattr(self, "input_theme"):
                self.input_theme.setStyleSheet("padding: 8px 12px; font-size: 12px; border: 1px solid #cbd5e1; border-radius: 6px; background-color: #ffffff; color: #1e293b;")
            if hasattr(self, "combo_mood"):
                self.combo_mood.setStyleSheet("padding: 7px; font-size: 12px; border: 1px solid #cbd5e1; border-radius: 6px; background-color: #ffffff; color: #1e293b;")

            # Step 2 Group Boxes & Inputs
            gb_qss_light = """
                QGroupBox {
                    font-weight: 700;
                    color: #1e293b;
                    border: 1px solid #e2e8f0;
                    border-radius: 8px;
                    margin-top: 10px;
                    padding: 10px;
                    background-color: #f8fafc;
                }
                QGroupBox::title {
                    subcontrol-origin: margin;
                    left: 10px;
                    padding: 0 4px;
                    color: #2563eb;
                }
            """
            for gb in [getattr(self, "bpm_box", None), getattr(self, "vocal_box", None), getattr(self, "prog_box", None), getattr(self, "metro_box", None), getattr(self, "voice_box", None)]:
                if gb:
                    gb.setStyleSheet(gb_qss_light)

            if hasattr(self, "lbl_bpm_display"):
                self.lbl_bpm_display.setStyleSheet("font-weight: 700; color: #2563eb; font-size: 13px;")
            if hasattr(self, "bpm_preset_btns"):
                for b in self.bpm_preset_btns:
                    b.setStyleSheet("background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 6px 10px; border-radius: 6px; font-size: 11px;")
            if hasattr(self, "combo_vocal"):
                self.combo_vocal.setStyleSheet("padding: 6px; font-size: 12px; border: 1px solid #cbd5e1; border-radius: 6px; background: #ffffff; color: #1e293b;")
            if hasattr(self, "lbl_vocal_info"):
                self.lbl_vocal_info.setStyleSheet("color: #64748b; font-size: 11px;")
            if hasattr(self, "combo_chords"):
                self.combo_chords.setStyleSheet("padding: 6px; font-size: 12px; border: 1px solid #cbd5e1; border-radius: 6px; background: #ffffff; color: #1e293b;")
            if hasattr(self, "lbl_chord_preview"):
                self.lbl_chord_preview.setStyleSheet("font-weight: 700; color: #2563eb; background: #eff6ff; padding: 6px 10px; border-radius: 6px;")
            if hasattr(self, "btn_w_play_chords"):
                self.btn_w_play_chords.setStyleSheet("background-color: #f5f3ff; color: #7c3aed; font-weight: 700; border: 1px solid #ddd6fe; border-radius: 6px; padding: 6px 12px;")
            if hasattr(self, "btn_w_stop_chords"):
                self.btn_w_stop_chords.setStyleSheet("background-color: #f1f5f9; color: #475569; font-weight: 600; border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px 10px;")

            # Step 3
            if hasattr(self, "action_card"):
                self.action_card.setStyleSheet("background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; padding: 12px;")
            if hasattr(self, "lbl_gen_summary"):
                self.lbl_gen_summary.setStyleSheet("font-weight: 600; color: #1d4ed8; font-size: 12px;")
            if hasattr(self, "lbl_step3_preview"):
                self.lbl_step3_preview.setStyleSheet("color: #1e293b; font-weight: 600; font-size: 12px;")
            if hasattr(self, "txt_preview"):
                self.txt_preview.setStyleSheet("background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 8px; font-size: 12px; color: #1e293b;")

            # Step 4
            if hasattr(self, "lbl_m_info"):
                self.lbl_m_info.setStyleSheet("color: #475569; font-size: 11px;")
            if hasattr(self, "btn_w_metro"):
                self.btn_w_metro.setStyleSheet("background: #f1f5f9; color: #2563eb; font-weight: 700; padding: 8px 14px; border-radius: 6px;")
            if hasattr(self, "v_desc"):
                self.v_desc.setStyleSheet("color: #64748b; font-size: 11px;")
            if hasattr(self, "btn_w_record"):
                self.btn_w_record.setStyleSheet("background-color: #fee2e2; color: #dc2626; font-weight: 700; border: 1px solid #fca5a5; border-radius: 6px; padding: 10px;")
            if hasattr(self, "btn_w_play_rec"):
                self.btn_w_play_rec.setStyleSheet("background: #f1f5f9; color: #334155; font-weight: 600; padding: 10px; border-radius: 6px;")
            if hasattr(self, "lbl_w_rec_status"):
                self.lbl_w_rec_status.setStyleSheet("color: #64748b; font-size: 11px; font-style: italic;")

            # Step 5
            if hasattr(self, "bundle_card"):
                self.bundle_card.setStyleSheet("background: #f0fdf4; border: 2px solid #86efac; border-radius: 12px; padding: 16px;")
            if hasattr(self, "lbl_b_title"):
                self.lbl_b_title.setStyleSheet("font-size: 14px; font-weight: 800; color: #166534;")
            if hasattr(self, "lbl_b_desc"):
                self.lbl_b_desc.setStyleSheet("color: #14532d; font-size: 12px; line-height: 1.5;")
            if hasattr(self, "lbl_step5_more"):
                self.lbl_step5_more.setStyleSheet("color: #1e293b; font-weight: 600; font-size: 12px;")
            if hasattr(self, "btn_open_full"):
                self.btn_open_full.setStyleSheet("background: #eff6ff; color: #1d4ed8; font-weight: 700; border: 1px solid #bfdbfe; padding: 12px; border-radius: 8px;")
            if hasattr(self, "btn_w_batch"):
                self.btn_w_batch.setStyleSheet("background: #faf5ff; color: #7c3aed; font-weight: 700; border: 1px solid #d8b4fe; padding: 12px; border-radius: 8px;")

        self._update_stepper()

    # --- Navigation Logic ---
    def _go_next(self):
        if self.current_step < 4:
            self.current_step += 1
            self.step_stack.setCurrentIndex(self.current_step)
            self._update_stepper()
        else:
            # Step 5 next goes to full editor workbench
            self.open_editor_requested.emit()

    def _go_prev(self):
        if self.current_step > 0:
            self.current_step -= 1
            self.step_stack.setCurrentIndex(self.current_step)
            self._update_stepper()
