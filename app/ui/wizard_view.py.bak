            if hasattr(self, "btn_w_record"):
                self.btn_w_record.setStyleSheet("background-color: #3b1115; color: #f87171; font-weight: 700; border: 1px solid #7f1d1d; border-radius: 6px; padding: 10px;")
            if hasattr(self, "btn_w_play_rec"):
                self.btn_w_play_rec.setStyleSheet("background: #161b30; color: #cbd5e1; border: 1px solid #283256; font-weight: 600; padding: 10px; border-radius: 6px;")
            if hasattr(self, "lbl_w_rec_status"):
                self.lbl_w_rec_status.setStyleSheet("color: #94a3b8; font-size: 11px; font-style: italic;")

            # Step 5
            if hasattr(self, "bundle_card"):
                self.bundle_card.setStyleSheet("background: #064e3b; border: 1px solid #059669; border-radius: 12px; padding: 16px;")
            if hasattr(self, "lbl_b_title"):
                self.lbl_b_title.setStyleSheet("font-size: 14px; font-weight: 800; color: #6ee7b7;")
            if hasattr(self, "lbl_b_desc"):
                self.lbl_b_desc.setStyleSheet("color: #a7f3d0; font-size: 12px; line-height: 1.5;")
